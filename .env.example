# European & German E-Invoicing Service endpoint used by REST and MCP samples
INVOICE_API_BASE_URL=http://localhost:5000

# Set this only when calling a Marketplace deployment
# INVOICE_API_KEY=your_marketplace_api_key

# Optional: canonical InvoiceDto JSON used by the MCP generate_invoice tool
# INVOICE_CANONICAL_JSON_PATH=./invoice.json

# Pillar Two & CbC Reporting Service endpoint used by the minimum-api-calls REST and MCP samples
MINIMUM_TAX_API_BASE_URL=https://minimum-tax-api-dev.simon-ai-enterprise.de

# Set this only when calling a Marketplace deployment
# MINIMUM_TAX_API_KEY=your_marketplace_api_key

# German Tax Filing Service endpoint used by the filing-api-calls sample
FILING_API_BASE_URL=https://filing-service-api.simon-ai-enterprise.de

# Set this only when the deployment requires an API key
# FILING_API_KEY=your_api_key

# Optional: ELSTER software certificate for the test transmission (simulation: true)
# FILING_CERTIFICATE_PATH=./certificate.pfx
# FILING_CERTIFICATE_PIN=your_pin
