# Invoice Services API endpoint used by REST and MCP samples
INVOICE_API_BASE_URL=http://localhost:5000

# Set this only when calling a Marketplace deployment
# INVOICE_API_KEY=your_marketplace_api_key

# Optional: canonical InvoiceDto JSON used by the MCP generate_invoice tool
# INVOICE_CANONICAL_JSON_PATH=./invoice.json

# Filing Service API endpoint used by the filing-api-calls sample
FILING_API_BASE_URL=http://localhost:8080

# Set this only when the Filing Service sits behind a gateway that expects X-API-Key
# FILING_API_KEY=your_gateway_api_key

# Optional: ELSTER test certificate for the simulated transmission (step 7)
# FILING_CERTIFICATE_PATH=./elster-test-cert.pfx
# FILING_CERTIFICATE_PIN=123456
