<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>InvoiceServices.Client</RootNamespace>
    <Description>Typed REST (Kiota, generated from /docs) and MCP clients for the E-Invoicing Service.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Kiota.Bundle" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <!-- The description the Kiota client was generated from; the docs reader compares it with the live one. -->
    <EmbeddedResource Include="OpenApi\v1.snapshot.json" LogicalName="InvoiceServices.Client.OpenApi.v1.snapshot.json" />
    <InternalsVisibleTo Include="InvoiceServices.Client.Tests" />
  </ItemGroup>

</Project>
